{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,

    // Temporary: lets .ts files import not-yet-migrated .js/.jsx files. Removed in the cleanup phase.
    "allowJs": true,
    "checkJs": false,

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
